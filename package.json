{
  "name": "desktop-agent-bridge",
  "version": "0.2.2",
  "description": "Ask Claude Desktop to review a Codex Desktop task with source context and returned findings.",
  "keywords": [
    "codex",
    "claude",
    "desktop",
    "code-review",
    "coding-agent",
    "peer-review",
    "context-handoff"
  ],
  "homepage": "https://github.com/WarrenJones/desktop-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/WarrenJones/desktop-agent-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WarrenJones/desktop-agent-bridge.git"
  },
  "author": "WarrenJones",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "dab": "bin/dab.js"
  },
  "scripts": {
    "install:local": "node scripts/install.js",
    "test": "node --test",
    "check": "node --check bin/dab.js && node --check src/*.js && node --check scripts/install.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "integrations/",
    ".claude-plugin/",
    "examples/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
